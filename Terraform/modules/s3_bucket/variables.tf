# ==============================================================================
# משתנה: שם דלי האחסון (Bucket Name)
# חובה שהשם הזה יהיה ייחודי לחלוטין בכל העולם של AWS,
# לא רק בחשבון שלך.
# ==============================================================================
variable "bucket_name" {
  description = "The name of the S3 bucket. Must be globally unique across all of AWS!"
  type        = string
}

# ==============================================================================
# משתנה: סביבת העבודה (Environment)
# משמש לסימון ותיוג (Tagging)
# של המשאב, למשל כדי לדעת אם זה דלי של פיתוח או ייצור.
# ==============================================================================
variable "environment" {
  description = "The environment name for tagging"
  type        = string
  default     = "Prod"
}