# ==============================================================================
# 1. בלוק הליבה - קלאסטר הקוברנטיס (Control Plane)
# מה הבלוק עושה: מפעיל את מודול ה-
# EKS
# הרשמי של
# AWS
# שמנהל את הקלאסטר.
# ==============================================================================
module "eks" {
  # ציון המקור: אומר לטרפורם להוריד את קוד ההקמה המוכר והבטוח של AWS
  source  = "terraform-aws-modules/eks/aws"
  # ציון גרסת המודול: שומר שהקוד לא ישתנה פתאום בעתיד וישבור לנו דברים
  version = "~> 20.0"

  # שם הקלאסטר: השם שיופיע בקונסולה של אמזון ובפקודות שלנו
  cluster_name    = "aviv-mission-cluster"
  # גרסת קוברנטיס: קובע במדויק איזו גרסת תוכנה תותקן 1.31 למניעת שדרוגים מפתיעים מ-
  # AWS
  cluster_version = "1.31"

  # בחירת הרשת (VPC): אומר לקלאסטר באיזו רשת של אמזון הוא הולך לחיות
  vpc_id = module.networking.vpc_id

  # בחירת תת-רשתות (Subnets): קובע שהשרתים יוקמו *רק* ברשתות הפרטיות כדי למנוע גישה ישירה מהאינטרנט - אבטחה
  subnet_ids = [
    module.networking.private_subnet_1_id,
    module.networking.private_subnet_2_id
  ]

  # פתיחת API
  # מקומי: מאפשר לך כמפתח להריץ פקודות kubectl מהמחשב בבית ללא צורך ב-VPN מורכב
  cluster_endpoint_public_access = true

  # ============================================================================
  # 2. תת-בלוק: כוח המחשוב והשרתים הפיזיים (Node Groups)
  # מה הבלוק עושה: מקימה את קבוצת שרתי ה-
  # EC2
  # שיריצו בפועל את הפודים של האפליקציה.
  # ============================================================================
  eks_managed_node_groups = {
    main_group = {
      # מינימום שרתים: השרת הבודד שתמיד חייב לרוץ, גם אם אין אף גולש באתר
      min_size       = 1
      # מקסימום שרתים: הגבול העליון לעומס, מונע מצב של חיוב מטורף אם יש עומס פתאומי
      max_size       = 4
      # גודל רצוי: כמות השרתים שתרוץ ביום-יום כברירת מחדל (4 שרתים)
      desired_size   = 4

      # סוג החומרה: מגדיר את כוח העיבוד והזיכרון של השרתים (t3.small - זול ומתאים לפיתוח)
      instance_types = ["t3.small"]
      # מערכת הפעלה: קובע שהשרתים ירוצו על לינוקס של אמזון (Amazon Linux 2)
      ami_type       = "AL2_x86_64"

      # תת-בלוק: הרשאות ברמת השרת הפיזי (IAM Role Policies)
      # נותן לשרתים עצמם אישור מאמזון ליצור דיסקים קשיחים (EBS) אם פוד יבקש לשמור קבצים פיזית
      iam_role_additional_policies = {
        AmazonEBSCSIDriverPolicy = "arn:aws:iam::aws:policy/service-role/AmazonEBSCSIDriverPolicy"
      }
    }
  }

  # ============================================================================
  # 3. תת-בלוק: מנהלי התקנים (Add-ons)
  # מה הבלוק עושה: מתקין תוכנות עזר רשמיות של אמזון בתוך הקוברנטיס.
  # ============================================================================
  cluster_addons = {
    # ה"דרייבר" של הדיסקים: מקשר בין קוברנטיס לכוננים הפיזיים של AWS (EBS)
    aws-ebs-csi-driver = {
      # דורש מאמזון להתקין תמיד את הגרסה החדשה והמאובטחת ביותר של התוסף הזה
      most_recent = true
    }
  }

  # ============================================================================
  # 4. תת-בלוק: אבטחה והרשאות מערכת
  # מה הבלוק עושה: מגדיר את מנגנוני הגישה לקלאסטר וממנו.
  # ============================================================================
  # מפעיל את מנגנון ה-IRSA: קריטי! מאפשר לתת הרשאות ספציפיות לפוד מסוים (כמו ל-Worker) במקום לכל השרת
  enable_irsa                              = true
  # נותן לך (מי שמריץ את טרפורם) הרשאות אדמין מלאות לקלאסטר באופן אוטומטי, כדי שלא תינעל בחוץ
  enable_cluster_creator_admin_permissions = true

  # תיוג המשאבים (Tags): עוזר לזהות לאיזה פרויקט ולאיזו סביבה שייך הקלאסטר בתוך הקונסולה של אמזון
  tags = {
    Environment = "dev"
    Project     = "aviv-mission"
  }
}

# ==============================================================================
# 5. השהייה לסנכרון (Time Sleep)
# מה הבלוק עושה: מחכה 30 שניות אחרי שהקלאסטר נוצר.
# למה זה פה? כי לוקח לרשת הפנימית של הקלאסטר זמן "להתעורר". אם ננסה להתקין
# תוכנות (Helm) מיד באותה שנייה, ההתקנה תיכשל.
# ==============================================================================
resource "time_sleep" "wait_for_eks" {
  depends_on      = [module.eks] # מתחיל לספור רק אחרי שבלוק ה-eks מסיים
  create_duration = "30s"
}

# ==============================================================================
# 6. התקנת נתב התעבורה (NGINX Ingress) באמצעות Helm
# מה הבלוק עושה: מתקין נתב פנימי ששולט בתעבורה הנכנסת לקלאסטר מהאינטרנט.
# ==============================================================================
resource "helm_release" "nginx_ingress" {
  name             = "ingress-nginx"
  # מאיפה להוריד את קוד ההתקנה (ה-Repository של NGINX)
  repository       = "https://kubernetes.github.io/ingress-nginx"
  chart            = "ingress-nginx"
  # יוצר תיקייה וירטואלית נפרדת (Namespace) בקוברנטיס כדי לשמור על סדר ולא לערבב עם האפליקציה
  namespace        = "ingress-nginx"
  create_namespace = true

  # אומר לטרפורם לחכות שהשהיית ה-30 שניות תסתיים לפני שהוא מתחיל להתקין
  depends_on = [time_sleep.wait_for_eks]

  # תת-בלוק: הגדרות ייעודיות ל-NGINX
  set {
    # אומר ל-AWS לייצר LoadBalancer ציבורי שיעביר את תעבורת הגולשים מבחוץ ישירות לנתב ה-NGINX
    name  = "controller.service.type"
    value = "LoadBalancer"
  }
}

# ==============================================================================
# 7. התקנת סוכן ניהול הסודות (External Secrets Operator) באמצעות Helm
# מה הבלוק עושה: מתקין רכיב שיודע למשוך סיסמאות מ-
# AWS
# ולשמור אותן בטוחות בקלאסטר.
# ==============================================================================
resource "helm_release" "external_secrets" {
  name             = "external-secrets"
  # מאיפה להוריד את קוד ההתקנה
  repository       = "https://charts.external-secrets.io"
  chart            = "external-secrets"
  # יצירת סביבה וירטואלית נפרדת (Namespace) עבור הרכיב הזה
  namespace        = "external-secrets"
  create_namespace = true

  depends_on = [time_sleep.wait_for_eks]

  # תת-בלוק: הגדרות ייעודיות ל-External Secrets
  set {
    # מתקין לתוך קוברנטיס "מילון מושגים" חדש (CRDs), כך שהוא ידע להבין פקודות של סודות חיצוניים
    name  = "installCRDs"
    value = "true"
  }

  # מבקש מטרפורם להמתין עד שההתקנה תסתיים ותהיה תקינה (עד 5 דקות) לפני שהוא ממשיך
  wait    = true
  timeout = 300
}

# ==============================================================================
# 8. פלט (Output) לנוחות תפעולית
# מה הבלוק עושה: חושף את פקודת ההתחברות לקלאסטר החוצה.
# ==============================================================================
output "configure_kubectl" {
  description = "Run this command to configure kubectl"
  value       = "aws eks update-kubeconfig --region us-east-1 --name ${module.eks.cluster_name}"
}