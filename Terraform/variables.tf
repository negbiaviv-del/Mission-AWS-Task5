# ==============================================================================
# משתנה: אזור העבודה באמזון (AWS Region)
# מטרה: קובע באיזה אזור (למשל us-east-1)
# יוקמו כל משאבי הענן של הפרויקט.
# ==============================================================================
variable "aws_region" {
  type    = string
  default = "us-east-1"
}

# ==============================================================================
# משתנה: שמו של דלי האחסון (S3 Bucket Name)
# מטרה: מגדיר את השם הייחודי עבור דלי ה-S3
# לשמירת קבצי האפליקציה.
# ==============================================================================
variable "bucket_name" {
  type = string
}

# ==============================================================================
# משתנה: טווח הכתובות של הרשת הווירטואלית (VPC CIDR)
# מטרה: מגדיר את גודל וטווח ה-IP
#-ים שיוקצו לכל רשת ה-VPC.
# ==============================================================================
variable "vpc_cidr" {
  type = string
}

# ==============================================================================
# משתנה: שם מסד הנתונים (DB Name)
# מטרה: קובע את שמו של מסד הנתונים שיוקм אוטומטית ב-PostgreSQL.
# ==============================================================================
variable "db_name" {
  type = string
}

# ==============================================================================
# משתנה: שמו של משתמש ה-Admin במסד הנתונים
# מטרה: מגדיר את שם המשתמש הראשי להתחברות ל-RDS.
# ==============================================================================
variable "db_user" {
  type = string
}

# ==============================================================================
# משתנה: שמו של הסוד ב-Secrets Manager
# מטרה: מגדיר את שם האובייקט שבו יישמרו פרטי ההתחברות המאוצפנים ל-RDS.
# ==============================================================================
variable "secret_name" {
  type = string
}

# ==============================================================================
# משתנה: תיאור הסוד (Secret Description)
# מטרה: מספק הסבר טקסטואלי בקונסולה של אמזון על מהות הסוד הנשמר.
# ==============================================================================
variable "secret_description" {
  description = "The description for the RDS secret"
  type        = string
}

# ==============================================================================
# משתנה: כתובת ה-IP
# הציבורית שלך (My IP)
# מטרה: משמש להגדרת חוקי אשתה/גישה נקודתיים במידת הצורך.
# ==============================================================================
variable "my_ip" {
  description = "Your public IP address"
  type        = string
}

# ==============================================================================
# משתנה: סיסמת המנהל הראשית ל-RDS
# (Master DB Password)
# מטרה: סיסמת ה-Admin
# למסד הנתונים. מוגדרת כרגישה (sensitive)
# למניעת זליגה ללוגים.
# ==============================================================================
variable "master_db_password" {
  description = "The master password for the RDS PostgreSQL database"
  type        = string
  sensitive   = true
}

# ==============================================================================
# משתנה: כתובת המייל להתראות (Alert Email)
# מטרה: כתובת המייל שאליה יישלחו התראות מערכת ממערכת ה-SNS.
# ==============================================================================
variable "my_alert_email" {
  description = "Email address for SNS subscriptions"
  type        = string
}
