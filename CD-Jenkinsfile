// ==============================================================================
// 1. Agent and Environment - סביבת ריצה עם kubectl ו-AWS CLI
// ==============================================================================
pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    component: cd-agent
spec:
  serviceAccountName: jenkins
  containers:
  - name: k8s-tools
    image: alpine/k8s:1.29.0
    command:
    - cat
    tty: true
'''
        }
    }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: 'latest',
            description: 'Docker Image Tag passed from CI pipeline'
        )
    }

    environment {
        AWS_REGION     = "us-east-1"
        CLUSTER_NAME   = "mission-eks-cluster" // שנה לשם הקלאסטר שלך ב-AWS
        ECR_REGISTRY   = "544471418394.dkr.ecr.us-east-1.amazonaws.com"
        K8S_DIR        = "K8S"                  // התיקייה שבה נמצאים קובצי ה-YAML
    }

    stages {
// ==============================================================================
// 2. Checkout - משיכת קובצי ה-Manifests (YAML) מה-Git
// ==============================================================================
        stage('Checkout Manifests') {
            steps {
                checkout scm
            }
        }

// ==============================================================================
// 3. Connect to EKS - חיבור והגדרת ה-Kubeconfig מול AWS EKS
// ==============================================================================
        stage('Configure Kubeconfig') {
            steps {
                container('k8s-tools') {
                    withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
                        sh '''
                        echo "Authenticating with AWS EKS..."
                        aws eks update-kubeconfig --region ${AWS_REGION} --name ${CLUSTER_NAME}

                        echo "Verifying cluster access:"
                        kubectl get nodes
                        '''
                    }
                }
            }
        }

// ==============================================================================
// 4. Deploy to EKS - עדכון האימג'ים ופריסה באמצעות kubectl
// ==============================================================================
        stage('Deploy to EKS') {
            steps {
                container('k8s-tools') {
                    withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
                        sh '''
                        echo "Deploying manifests from ${K8S_DIR}..."

                        # 1. החלת המשאבים הכלליים (ConfigMaps, Secrets, Services וכד')
                        kubectl apply -f ${K8S_DIR}/

                        # 2. עדכון התמונות של ה-Deployments לגרסה החדשה שהתקבלה מה-CI
                        echo "Updating deployment images to tag: ${params.IMAGE_TAG}"

                        kubectl set image deployment/backend backend=${ECR_REGISTRY}/mission-backend:${params.IMAGE_TAG}
                        kubectl set image deployment/frontend frontend=${ECR_REGISTRY}/mission-frontend:${params.IMAGE_TAG}
                        kubectl set image deployment/worker worker=${ECR_REGISTRY}/mission-worker:${params.IMAGE_TAG}
                        '''
                    }
                }
            }
        }

// ==============================================================================
// 5. Verify Rollout - וידוא שהפודים עלו בהצלחה
// ==============================================================================
        stage('Verify Rollout') {
            steps {
                container('k8s-tools') {
                    withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
                        sh '''
                        echo "Checking rollout status for deployments..."
                        kubectl rollout status deployment/backend --timeout=120s
                        kubectl rollout status deployment/frontend --timeout=120s
                        kubectl rollout status deployment/worker --timeout=120s

                        echo "All pods are up and running:"
                        kubectl get pods
                        '''
                    }
                }
            }
        }
    }

    post {
        failure {
            echo "Deployment failed! Consider rolling back via: kubectl rollout undo deployment/<name>"
        }
        success {
            echo "Deployment to EKS completed successfully with image tag: ${params.IMAGE_TAG}"
        }
    }
}
