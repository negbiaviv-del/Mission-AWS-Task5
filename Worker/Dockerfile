# ==============================================================================
# מתכון בניית ה-Worker:
# ==============================================================================
# יצירת סביבת פייתון רזה להרצת סוכן הרקע
# (Background Worker)
# ==============================================================================
# שימוש בתמונת בסיס קטנה ורזה של פייתון
FROM python:3.11-slim

# הגדרת תיקיית העבודה בתוך הקונטיינר
WORKDIR /app

# העתקת רשימת הספריות והתקנתן ללא שמירת מטמון כדי לחסוך מקום
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# העתקת קוד המקור
# (worker_sqs.py) לתוך הקונטיינר
COPY . .

# הפקודה שתרוץ ברגע שהפוד יעלה בקוברנטיס - הפעלת המאזין לתור ההודעות
CMD ["python3", "worker_sqs.py"]