// ==============================================================================
// 1. Agent and Environment - סביבת הריצה והמשתנים
// ==============================================================================
pipeline {
    agent {
        kubernetes {
            // הגדרת פוד זמני שישמש כשרת הבניה שלנו
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    component: ci-agent # תווית לזיהוי הפוד
spec:
  serviceAccountName: jenkins # הרשאה לפוד מול קוברנטיס
  containers:
  - name: docker
    image: docker:24.0.5-dind # Docker in Docker
    securityContext:
      privileged: true # חובה עבור הרצת דוקר בתוך קונטיינר
    tty: true
    env:
    - name: DOCKER_TLS_CERTDIR
      value: "" # ביטול הצפנה פנימית למניעת תקלות
  - name: tools
    image: hashicorp/terraform:1.5
    command:
    - cat
    tty: true
  - name: python
    image: python:3.11-slim
    command:
    - cat
    tty: true
  - name: trivy
    image: aquasec/trivy:latest
    command:
    - cat
    tty: true
'''
        }
    }

    environment {
        // כתובת מאגר התמונות שלנו באמזון
        ECR_REGISTRY = "544471418394.dkr.ecr.us-east-1.amazonaws.com"
        AWS_REGION = "us-east-1"
        // יצירת תגית ייחודית מבוססת גיט או מספר בניה
        IMAGE_TAG = "${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : env.BUILD_NUMBER}"
    }

    stages {
// ==============================================================================
// 2. Checkout - משיכת הקוד
// ==============================================================================
        stage('Checkout') {
            steps {
                // הורדת הקוד מהמאגר
                checkout scm
            }
        }

// ==============================================================================
// 3. Lint and Validate - בדיקות תקינות
// ==============================================================================
        stage('Lint & Validate') {
            parallel {
                stage('Terraform') {
                    steps {
                        container('tools') {
                            dir('Terraform') {
                                sh '''
                                # בדיקת עיצוב הקוד
                                terraform fmt -check
                                # אתחול ללא חיבור לענן
                                terraform init -backend=false
                                # בדיקת לוגיקה
                                terraform validate
                                '''
                            }
                        }
                    }
                }
                stage('Python & YAML') {
                    steps {
                        container('python') {
                            sh '''
                            # בדיקת קבצי יאמל
                            pip install yamllint
                            # קימפול קוד פייתון לבדיקת שגיאות
                            python -m py_compile Backend/*.py
                            python -m py_compile Worker/*.py
                            yamllint K8S/
                            '''
                        }
                    }
                }
                stage('Observability configs') {
                    steps {
                        container('python') {
                            sh '''
                            echo "Validating Dashboards YAML..."
                            pip install pyyaml
                            # בדיקת תקינות קובץ הדאשבורד
                            python -c 'import yaml, sys; yaml.safe_load(open("monitoring/backend-dashboard.yaml"))' || exit 1

                            echo "Installing curl..."
                            apt-get update && apt-get install -y curl

                            echo "Extracting Prometheus rules..."
                            # חילוץ חוקי התראות לבדיקה
                            python -c 'import yaml; doc = yaml.safe_load(open("monitoring/app-alerts.yaml")); yaml.dump(doc.get("spec", {}), open("monitoring/pure-rules.yaml", "w"))'

                            echo "Validating Prometheus Rules..."
                            # הרצת כלי רשמי לבדיקת חוקי ההתראות
                            curl -s -L https://github.com/prometheus/prometheus/releases/download/v2.45.0/prometheus-2.45.0.linux-amd64.tar.gz | tar xz
                            ./prometheus-2.45.0.linux-amd64/promtool check rules monitoring/pure-rules.yaml
                            '''
                        }
                    }
                }
            }
        }

// ==============================================================================
// 4. Security Scans - סריקות אבטחה
// ==============================================================================
        stage('Security Scans (Trivy)') {
            steps {
                container('trivy') {
                    // סריקת הקבצים לחולשות אבטחה
                    sh 'trivy fs --format table --exit-code 0 --severity CRITICAL,HIGH .'
                }
            }
        }

// ==============================================================================
// 5. Build and Push - בניה והעלאה
// ==============================================================================
        stage('Build & Push to ECR') {
            steps {
                container('docker') {
                    withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
                        sh '''
                        # הפעלת שירות דוקר ברקע
                        dockerd &
                        sleep 10

                        # התקנת כלי אמזון
                        apk add --no-cache aws-cli

                        # התחברות למאגר התמונות
                        aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin $ECR_REGISTRY

                        # בנית התמונות עם התגית הייחודית
                        docker build -t $ECR_REGISTRY/mission-backend:$IMAGE_TAG ./Backend
                        docker build -t $ECR_REGISTRY/mission-frontend:$IMAGE_TAG ./Frontend
                        docker build -t $ECR_REGISTRY/mission-worker:$IMAGE_TAG ./Worker

                        # העלאת התמונות לענן
                        docker push $ECR_REGISTRY/mission-backend:$IMAGE_TAG
                        docker push $ECR_REGISTRY/mission-frontend:$IMAGE_TAG
                        docker push $ECR_REGISTRY/mission-worker:$IMAGE_TAG
                        '''
                    }
                }
            }
        }

// ==============================================================================
// 6. Publish and Trigger CD - העברת שרביט
// ==============================================================================
        stage('Publish Metadata') {
            steps {
                // שמירת מספר הגרסה בקובץ
                writeFile file: 'image_tag.txt', text: "${IMAGE_TAG}"
                archiveArtifacts artifacts: 'image_tag.txt'
            }
        }

        stage('Trigger CD') {
            steps {
                // הפעלת תהליך הפריסה והעברת הגרסה הלאה
                build job: 'Application-CD', parameters: [
                    string(name: 'IMAGE_TAG', value: "${IMAGE_TAG}")
                ], wait: false
            }
        }
    }
}