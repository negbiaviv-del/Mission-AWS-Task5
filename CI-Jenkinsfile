# ==============================================================================
# 1. הגדרות רשת והרשאות (Controller & ServiceAccount)
# מה הבלוק עושה: חושף את ג'נקינס לעולם דרך
# LoadBalancer
# ומחבר אותו להרשאות שיצרנו ב-
# RBAC.
# למה צריך את זה: כדי שתוכל לגשת לממשק של ג'נקינס בדפדפן, וכדי שג'נקינס יקבל אישור מקוברנטיס לפרוס את האפליקציה - הוא משתמש בחשבון הקיים ולא יוצר אחד חדש.
# ==============================================================================
controller:
  serviceType: LoadBalancer
  serviceAccount:
    create: false
    name: jenkins-admin

# ==============================================================================
# 1.5. הבטחת משאבים למניעת קריסות (Resources)
# מה הבלוק עושה: משריין כמות מינימלית ומקסימלית של זיכרון וכוח עיבוד
# (CPU) עבור הפוד של ג'נקינס.
# למה צריך את זה: מונע מפודים אחרים (כמו עבודות CI כבדות) "לחנוק" את ג'נקינס. זה מבטיח
# שלתהליך ההכנה והורדת הפלאגינים
# (Init)
# יהיה תמיד מספיק כוח וזיכרון לרוץ ללא שגיאות Timeout או OOMKilled.
# ==============================================================================
  resources:
  requests:
    cpu: "250m"
    memory: "512Mi"
  limits:
    cpu: "1000m"
    memory: "2Gi"

# ==============================================================================
# 2. אחסון קבוע (Persistence)
# מה הבלוק עושה: מקצה לג'נקינס כונן קשיח וירטואלי
# (EBS מסוג gp2) בנפח 8GB.
# למה צריך את זה: פודים בקוברנטיס נמחקים ונוצרים מחדש. ללא אחסון קבוע, כל היסטוריית הריצות
# (Builds)
# וההגדרות של ג'נקינס יימחקו בכל פעם שהפוד נופל או מתעדכן.
# ==============================================================================
  persistence:
    storageClass: "gp2"
    size: "8Gi"

# ==============================================================================
# 3. הזרקת סודות מאובטחת (Environment Variables)
# מה הבלוק עושה: מושך את מפתחות הגישה ל-
# AWS ול-
# GitHub
# מתוך הסודות של קוברנטיס, והופך אותם למשתני סביבה בתוך הקונטיינר של ג'נקינס.
# למה צריך את זה: הדרך הבטוחה ביותר לספק לג'נקינס הרשאות למשוך קוד ולדחוף אימג'ים ל-
# ECR,
# מבלי לכתוב סיסמאות כטקסט גלוי בקובץ.
# ==============================================================================
  containerEnv:
    - name: AWS_ACCESS_KEY_ID
      valueFrom:
        secretKeyRef:
          name: aws-credentials-secret
          key: aws_access_key_id
    - name: AWS_SECRET_ACCESS_KEY
      valueFrom:
        secretKeyRef:
          name: aws-credentials-secret
          key: aws_secret_access_key
    - name: GITHUB_USERNAME
      valueFrom:
        secretKeyRef:
          name: github-credentials-secret
          key: github_username
    - name: GITHUB_TOKEN
      valueFrom:
        secretKeyRef:
          name: github-credentials-secret
          key: github_token

# ==============================================================================
# 4. התקנת תוספים אוטומטית (Plugins)
# מה הבלוק עושה: מורה ל-
# Helm
# להתקין מראש רשימה של פלאגינים חיוניים בעת הקמת השרת.
# למה צריך את זה: חוסך את הצורך להיכנס לממשק של ג'נקינס ולהתקין ידנית כלים כמו התממשקות לגיט, קוברנטיס,
# AWS
# ומערכת פרומיתיאוס
# (עבור ה-ServiceMonitor עברנו עליו קודם).
# ==============================================================================
  installPlugins:
    - kubernetes
    - workflow-aggregator
    - git
    - configuration-as-code
    - job-dsl
    - credentials-binding
    - aws-credentials
    - pipeline-stage-view
    - prometheus

# ==============================================================================
# 5. קינפוג ג'נקינס בקוד (JCasC - Jenkins Configuration as Code)
# מה הבלוק עושה: אוסף את משתני הסביבה שהזרקנו ומייצר מהם אובייקטים של
# Credentials
# בתוך ג'נקינס. בנוסף, הוא יוצר אוטומטית את 2 הפייפליינים
# (CI ו-CD)
# שמצביעים למאגר הגיטהאב שלך.
# למה צריך את זה: זה מה שהופך את הפרויקט שלך ל-
# "One-Touch".
# ברגע שהסקריפט מסיים, ג'נקינס קם כשהוא כבר מקונפג במלואו, יודע להתחבר לגיט ולאמזון, ומכיל את עבודות ה-
# Pipeline
# מוכנות להרצה.
# ==============================================================================
  JCasC:
    defaultConfig: true
    configScripts:
      credentials: |
        credentials:
          system:
            domainCredentials:
              - credentials:
                  - aws:
                      scope: GLOBAL
                      id: "aws-credentials"
                      description: "AWS Credentials for ECR"
                      accessKey: "${AWS_ACCESS_KEY_ID}"
                      secretKey: "${AWS_SECRET_ACCESS_KEY}"
                  - usernamePassword:
                      scope: GLOBAL
                      id: "github-credentials"
                      description: "GitHub Credentials for pulling code"
                      username: "${GITHUB_USERNAME}"
                      password: "${GITHUB_TOKEN}"
      setup-jenkins: |
        jobs:
          - script: >
              pipelineJob('Application - CI') {
                  description('CI Pipeline - Builds Docker images and pushes to ECR')
                  definition {
                      cpsScm {
                          scm {
                              git {
                                  remote {
                                      url('https://github.com/negbiaviv-del/Mission-AWS-Task5.git')
                                      credentials('github-credentials')
                                  }
                                  branch('*/main')
                              }
                          }
                          scriptPath('CI-Jenkinsfile')
                      }
                  }
              }
          - script: >
              pipelineJob('Application - CD') {
                  description('CD Pipeline - Deploys a specific image tag to EKS')
                  parameters {
                      stringParam('IMAGE_TAG', '', 'The unique image tag to deploy')
                  }
                  definition {
                      cpsScm {
                          scm {
                              git {
                                  remote {
                                      url('https://github.com/negbiaviv-del/Mission-AWS-Task5.git')
                                      credentials('github-credentials')
                                  }
                                  branch('*/main')
                              }
                          }
                          scriptPath('CD-Jenkinsfile')
                      }
                  }
              }
