// ==============================================================================
// 1. Agent and Environment - סביבת הריצה והמשתנים
// ==============================================================================
pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    component: ci-agent
spec:
  serviceAccountName: jenkins
  containers:
  - name: docker
    image: docker:24.0.5-dind
    securityContext:
      privileged: true
    tty: true
    env:
    - name: DOCKER_TLS_CERTDIR
      value: ""
  - name: python
    image: python:3.11-slim
    command:
    - cat
    tty: true
  - name: trivy
    image: aquasec/trivy:latest
    command:
    - cat
    tty: true
'''
        }
    }

    // הוספת מנגנון הדגימה האוטומטי מול Git
    triggers {
        // ביטוי ה-Cron אומר: "תדגום את ה-Git כל דקה" (* * * * *)
        pollSCM('* * * * *')
    }

    environment {
        ECR_REGISTRY = "544471418394.dkr.ecr.us-east-1.amazonaws.com"
        AWS_REGION = "us-east-1"
        IMAGE_TAG = "${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : env.BUILD_NUMBER}"
    }

    stages {
// ==============================================================================
// 2. Checkout - משיכת הקוד
// ==============================================================================
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

// ==============================================================================
// 3. Lint & Validate - בדיקות תקינות לקוד האפליקציה בלבד
// ==============================================================================
        stage('Lint & Validate') {
            steps {
                container('python') {
                    sh '''
                    echo "Installing linters..."
                    pip install yamllint

                    echo "Linting Backend (Python)..."
                    python -m py_compile Backend/*.py

                    echo "Linting Worker (Python)..."
                    python -m py_compile Worker/*.py

                    echo "Linting Frontend (Configs)..."
                    yamllint Frontend/ || true
                    '''
                }
            }
        }

// ==============================================================================
// 4. Build Images - בניית התמונות
// ==============================================================================
        stage('Build Images') {
            steps {
                container('docker') {
                    sh '''
                    # הפעלת שירות דוקר ברקע עבור שלב הבנייה
                    dockerd &
                    sleep 10

                    echo "Building Images..."
                    docker build -t $ECR_REGISTRY/mission-backend:$IMAGE_TAG ./Backend
                    docker build -t $ECR_REGISTRY/mission-frontend:$IMAGE_TAG ./Frontend
                    docker build -t $ECR_REGISTRY/mission-worker:$IMAGE_TAG ./Worker

                    echo "Saving images to tar files for Trivy scan..."
                    docker save $ECR_REGISTRY/mission-backend:$IMAGE_TAG -o backend-image.tar
                    docker save $ECR_REGISTRY/mission-frontend:$IMAGE_TAG -o frontend-image.tar
                    docker save $ECR_REGISTRY/mission-worker:$IMAGE_TAG -o worker-image.tar
                    '''
                }
            }
        }

// ==============================================================================
// 5. Security Scans (Trivy) - סריקות אבטחה לתמונות
// ==============================================================================
        stage('Security Scans (Trivy)') {
            steps {
                container('trivy') {
                    sh '''
                    echo "Scanning Backend Image..."
                    trivy image --input backend-image.tar --format table --exit-code 0 --severity CRITICAL,HIGH

                    echo "Scanning Frontend Image..."
                    trivy image --input frontend-image.tar --format table --exit-code 0 --severity CRITICAL,HIGH

                    echo "Scanning Worker Image..."
                    trivy image --input worker-image.tar --format table --exit-code 0 --severity CRITICAL,HIGH
                    '''
                }
            }
        }

// ==============================================================================
// 6. Push to ECR - העלאת התמונות לענן
// ==============================================================================
        stage('Push to ECR') {
            steps {
                container('docker') {
                    withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
                        sh '''
                        # הפעלת שירות דוקר מחדש לשלב ההעלאה
                        dockerd &
                        sleep 10

                        echo "Loading scanned images..."
                        docker load -i backend-image.tar
                        docker load -i frontend-image.tar
                        docker load -i worker-image.tar

                        echo "Authenticating with AWS ECR..."
                        apk add --no-cache aws-cli
                        aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin $ECR_REGISTRY

                        echo "Pushing images to ECR..."
                        docker push $ECR_REGISTRY/mission-backend:$IMAGE_TAG
                        docker push $ECR_REGISTRY/mission-frontend:$IMAGE_TAG
                        docker push $ECR_REGISTRY/mission-worker:$IMAGE_TAG
                        '''
                    }
                }
            }
        }

// ==============================================================================
// 7. Publish & Trigger CD - העברת שרביט לפריסה
// ==============================================================================
        stage('Publish & Trigger CD') {
            steps {
                writeFile file: 'image_tag.txt', text: "${IMAGE_TAG}"
                archiveArtifacts artifacts: 'image_tag.txt'

                build job: 'Application - CD', parameters: [
                    string(name: 'IMAGE_TAG', value: "${IMAGE_TAG}")
                ], wait: false
            }
        }
    }
}
